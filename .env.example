# Configuración de Entornos para "¿Qué comemos hoy?" (Mati entre ollas)

# Puerto del API Gateway
PORT_GATEWAY=8000

# Claves de APIs (Opcionales para desarrollo local; los microservicios tienen mocks automáticos de respaldo)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
# O si prefieres OpenAI:
OPENAI_API_KEY=tu_api_key_de_openai_aqui

# Weather API (OpenWeatherMap)
WEATHER_API_KEY=tu_api_key_de_openweather_aqui

# URL de Redes Sociales de "Mati entre ollas"
MATI_INSTAGRAM_URL=https://www.instagram.com/matientreollas
MATI_TIKTOK_URL=https://www.tiktok.com/@matientreollas
