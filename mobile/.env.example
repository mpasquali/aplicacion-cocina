# Configuración de Entorno para la App Móvil (React Native / Expo)
#
# Opciones según el entorno de ejecución:
# - Web o iOS Simulator: http://localhost:8000
# - Emulador Android (Genymotion / Android Studio): http://10.0.2.2:8000
# - Dispositivo físico mediante Expo Go (misma red Wi-Fi): http://<TU_IP_LOCAL>:8000 (ej: http://192.168.1.48:8000)
#
EXPO_PUBLIC_API_URL=http://localhost:8000

